# API Gateway Environment Configuration
NODE_ENV=development
PORT=3000

# Redis Configuration (for BullMQ job queue)
REDIS_HOST=localhost
REDIS_PORT=6379

# MCP Server Configuration
MCP_SERVER_URL=http://localhost:8001

# Worker Configuration
WORKER_CONCURRENCY=2

# Security
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Logging
LOG_LEVEL=info

# Outputs (should match MCP server configuration)
BLENDER_OUTPUT_DIR=../outputs

# === Claude AI Configuration ===
# Enable Claude AI mesh classification
CLAUDE_ENABLED=false

# Minimum confidence threshold for AI override (0.0-1.0)
CLAUDE_CONFIDENCE_THRESHOLD=0.85

# === GTIN Naming Configuration ===
# Enable GTIN-based filename generation
GTIN_ENABLED=false

