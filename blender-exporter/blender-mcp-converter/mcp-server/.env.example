# MCP Server Environment Configuration
PYTHONPATH=.
LOG_LEVEL=INFO

# Server Configuration
HOST=localhost
PORT=8001

# Blender Configuration (macOS paths)
# Auto-detected by server: /Applications/Blender.app/Contents/MacOS/Blender or blender
BLENDER_EXECUTABLE=auto
BLENDER_TIMEOUT=300
# Shared outputs directory (absolute path recommended; default ../outputs relative to MCP server)
BLENDER_OUTPUT_DIR=../outputs

# Redis Configuration (if needed for caching)
REDIS_HOST=localhost
REDIS_PORT=6379

# AI Model Configuration (legacy - kept for compatibility)
AI_MODEL_PATH=models/material_recognition.pt
AI_ENABLED=false

# === CLAUDE AI CONFIGURATION ===
# Get your API key from: https://console.anthropic.com/
CLAUDE_API_KEY=sk-ant-api03-...
CLAUDE_MODEL=claude-3-5-sonnet-20241022
CLAUDE_MAX_TOKENS=1024
CLAUDE_TEMPERATURE=0.2
CLAUDE_USE_VISION=false  # Enable for preview image analysis (higher cost)

# === GTIN NAMING CONFIGURATION ===
# Path to XLSX/CSV file with GTIN mappings
GTIN_DATABASE_PATH=data/gtin_mappings.xlsx
GTIN_ENABLED=false
# Column names in XLSX/CSV
GTIN_COLUMN_NAME=GTIN
PRODUCT_NAME_COLUMN=ProductName

# === MATERIAL ASSIGNMENT (Future) ===
MATERIAL_DATABASE_PATH=data/materials.json
MATERIAL_ASSIGNMENT_ENABLED=false