# syntax=docker/dockerfile:1
# Build-Context: vendor/blender-mcp-converter

FROM python:3.11-slim-bookworm
WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends blender ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY mcp-server/requirements.txt ./mcp-server/requirements.txt
RUN pip install --no-cache-dir -r mcp-server/requirements.txt

COPY mcp-server ./mcp-server
COPY blender-scripts ./blender-scripts
COPY data ./data

ENV PYTHONUNBUFFERED=1
ENV HOST=0.0.0.0
ENV PORT=8001
ENV BLENDER_PATH=/usr/bin/blender
ENV BLENDER_EXECUTABLE=/usr/bin/blender
ENV BLENDER_OUTPUT_DIR=/data/outputs
ENV USDZ_BLUE_COMPENSATION=false
ENV EXPORT_USDZ_OVERWRITE=true

RUN mkdir -p /data/outputs

WORKDIR /app/mcp-server
EXPOSE 8001
CMD ["python", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8001"]
