# META Showroom – Online/Docker (.env für deploy/docker/docker-compose.yml)
# Kopieren: cp deploy/docker/.env.example deploy/docker/.env

# Öffentliche URL (für Origin-Checks / CORS)
SHOWROOM_ORIGIN=http://localhost:8080

# Externes CDN/Storage für GLB/USDZ/Thumbnails (ohne trailing slash)
# Beispiel: https://cdn.example.com/showroom-assets
VITE_ASSET_BASE_URL=

# HTTP-Port des Reverse-Proxys (öffentlicher Einstieg)
HTTP_PORT=8080

# Shared Secret für Dashboard-API (optional, zusätzlich zu Basic-Auth)
SHOWROOM_API_TOKEN=

# Konverter / KI (optional)
CLAUDE_API_KEY=
CLAUDE_ENABLED=false
GTIN_ENABLED=false
CONVERTER_RATE_LIMIT_MAX=100

# Basic-Auth: htpasswd-Datei deploy/docker/htpasswd anlegen, z. B.:
#   docker run --rm httpd:2.4-alpine htpasswd -nbB admin 'geheim' > deploy/docker/htpasswd
