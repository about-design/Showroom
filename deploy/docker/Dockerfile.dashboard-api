# syntax=docker/dockerfile:1

FROM node:20-bookworm-slim AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev

FROM node:20-bookworm-slim
WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    blender \
    chromium \
    ca-certificates \
    fonts-liberation \
  && rm -rf /var/lib/apt/lists/*

ENV BLENDER_PATH=/usr/bin/blender
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
ENV NODE_ENV=production
ENV DASHBOARD_API_PORT=5080
ENV SHOWROOM_HOST=0.0.0.0

COPY --from=deps /app/node_modules ./node_modules
COPY package.json package-lock.json ./
COPY server ./server
COPY scripts ./scripts
COPY src ./src
COPY public ./public
COPY index.html dashboard.html converter.html ./

RUN mkdir -p src/data logs \
  && test -f src/data/products.json || echo '{"products":[]}' > src/data/products.json \
  && test -f src/data/cad-index.json || echo '{"objDir":"/models/obj","productCadFiles":{}}' > src/data/cad-index.json

EXPOSE 5080
CMD ["node", "server/dashboard-server.mjs"]
